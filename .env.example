# Copiar para .env e preencher. O .env não vai para o git.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_SITE_URL=https://quota.milsonuix.com

# ── Só no servidor (Hostinger → variáveis de ambiente). Nunca com prefixo VITE_. ──
# Supabase → Settings → API Keys → secret / service_role. Ignora o RLS.
SUPABASE_SERVICE_ROLE_KEY=
# Payzeno → API & Webhook → aplicação "Quota"
PAYZENO_API_KEY=
PAYZENO_WEBHOOK_SECRET=whsec_...
# Opcionais (valores por omissão entre parênteses)
# PAYZENO_AMOUNT_UNIT=minor        (minor = cêntimos; major = meticais) — confirmar no 1.º pagamento
# PAYZENO_SIGNATURE_HEADER=payzeno-signature
# PAYZENO_BASE=https://api.payzeno.io/v1
# CRON_SECRET=…                  (lembretes diários do plano; igual ao segredo quota_cron_secret no Vault do Supabase)
# PAYZENO_TEST_AMOUNT_MT=1       (só para testes: cobra 1 MT em qualquer plano — retirar depois)
